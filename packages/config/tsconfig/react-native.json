{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Casa React Native app (mirrors expo/tsconfig.base, plus strict)",
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["DOM", "ESNext"],
    "types": [],
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "module": "preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "customConditions": ["react-native"],
    "resolveJsonModule": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "${configDir}/**/*.ts",
    "${configDir}/**/*.tsx",
    "${configDir}/.expo/types/**/*.ts",
    "${configDir}/expo-env.d.ts"
  ],
  "exclude": [
    "${configDir}/node_modules",
    "${configDir}/dist",
    "${configDir}/babel.config.js",
    "${configDir}/metro.config.js",
    "${configDir}/ios",
    "${configDir}/android"
  ]
}
