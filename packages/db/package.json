  },
  "devDependencies": {
    "@ghar/config": "workspace:*",
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "24.13.4",
    "drizzle-kit": "^0.31.10",
    "typescript": "6.0.3",
    "vite": "^8.3.0",
    "vitest": "5.0.0"
