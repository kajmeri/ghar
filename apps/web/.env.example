# Copy to .env.local. Server-only: nothing here is exposed to the browser.

# Supabase transaction pooler (port 6543); @ghar/db disables prepared statements for it.
DATABASE_URL=postgresql://postgres.project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres

# Supabase dashboard > Project Settings > API. The legacy anon key also works as the publishable key.
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# `pnpm db:seed` uses the secret key to create demo users. In production the app reads it only for
# STORAGE_PROVIDER=supabase, to sign document links on the server. It never reaches a browser.
SUPABASE_SECRET_KEY=
# Optional: seed the demo household with addresses you can receive mail at.
# SEED_OWNER_EMAIL=
# SEED_ADULT_EMAIL=

# Origin used in emailed links. Must also be in Supabase Auth > URL Configuration.
APP_URL=http://localhost:3000

# Ghar has no public signup. These addresses may create an account without an invitation
# (comma-separated); everyone else needs one. Existing accounts can always sign in.
SIGNUP_EMAILS=you@example.com

# Leave RESEND_API_KEY blank locally and invitation emails print to the dev server console.
RESEND_API_KEY=
EMAIL_FROM=Ghar <ghar@your-verified-domain.com>

# Vercel Cron sends this as a bearer token; set the same value in Vercel. At least 16 characters,
# for example from `openssl rand -hex 32`. Cron routes answer 401 while it's blank.
CRON_SECRET=

# Where the daily fare watch gets prices. fake (the default) quotes what you paid until you set a
# price on a booking's page. travelpayouts needs a Data API token from travelpayouts.com.
PRICE_PROVIDER=fake
TRAVELPAYOUTS_TOKEN=

# Seals Google refresh tokens at rest. Generate with `openssl rand -base64 32`. Set it once per
# environment: changing it means everyone has to connect their calendar again.
ENCRYPTION_KEY=

# Calendar linking. fake (the default) links a sample calendar without Google. For google, create
# an OAuth client (Web application) in Google Cloud with the Calendar API enabled, and add
# ${APP_URL}/api/calendar/google/callback as an authorized redirect URI.
CALENDAR_PROVIDER=fake
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Travel times between itinerary stops. estimate (the default) works them out from distance and
# needs nothing. osrm asks an OSRM server for walking and driving routes, and sends it the trip's
# coordinates to do so.
ROUTING_PROVIDER=estimate
OSRM_URL=

# Document files. fake (the default) keeps uploads in the dev server's memory until it restarts.
# supabase stores them in the private `documents` bucket (migration 0006) and needs
# SUPABASE_SECRET_KEY. Production refuses fake.
STORAGE_PROVIDER=fake
