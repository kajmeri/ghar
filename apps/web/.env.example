# Copy to .env.local. Server-only: nothing here is exposed to the browser, except
# NEXT_PUBLIC_SENTRY_DSN, which the build puts in the client bundle.

# Supabase transaction pooler (port 6543); @ghar/db disables prepared statements for it.
DATABASE_URL=postgresql://postgres.project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres

# Supabase dashboard > Project Settings > API. The legacy anon key also works as the publishable key.
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# `pnpm db:seed` uses the secret key to create demo users. In production the app reads it only for
# STORAGE_PROVIDER=supabase, to sign document links on the server. It never reaches a browser.
SUPABASE_SECRET_KEY=
# Optional: seed the demo household with addresses you can receive mail at.
# SEED_OWNER_EMAIL=
# SEED_ADULT_EMAIL=

# Origin used in emailed links. Must also be in Supabase Auth > URL Configuration. Leave it unset on
# Vercel: production uses the project's production domain and a preview uses its branch URL.
APP_URL=http://localhost:3000

# Leave RESEND_API_KEY blank locally and invitation emails print to the dev server console.
# Mail goes out from Resend's test sender, which delivers only to your Resend account's address.
RESEND_API_KEY=

# Vercel Cron sends this as a bearer token; set the same value in Vercel. At least 16 characters,
# for example from `openssl rand -hex 32`. Cron routes answer 401 while it's blank.
CRON_SECRET=

# Data API token from travelpayouts.com for the daily fare watch. Leave it blank locally and the
# watch quotes what you paid until you set a price on a booking's page. Production requires it.
TRAVELPAYOUTS_TOKEN=

# Seals Google refresh tokens at rest. Generate with `openssl rand -base64 32`. Set it once per
# environment. To change it, follow "Rotate the encryption key" in docs/runbook.md; changing it
# without those steps means everyone has to connect their calendar and Gmail again.
ENCRYPTION_KEY=
# Only while rotating: the key being retired, so what it sealed still opens until the reseal script
# has run. Leave it blank otherwise.
ENCRYPTION_KEY_PREVIOUS=

# Calendar linking and Gmail booking import. Create an OAuth client (Web application) in Google
# Cloud with the Calendar API and the Gmail API enabled, and add both
# ${APP_URL}/api/calendar/google/callback and ${APP_URL}/api/mail/google/callback as authorized
# redirect URIs. Gmail asks only for gmail.readonly. While the consent screen is in Testing, add
# each person as a test user; Google expires Testing refresh tokens after 7 days, so they'll need
# to reconnect weekly until the app is published. Leave both blank locally to link a sample
# calendar and inbox instead. Production requires them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Claude Haiku reads booking confirmations found in linked Gmail inboxes. What it reads waits in a
# review queue; nothing becomes a booking until someone confirms it. Leave it blank locally to use a
# canned reader for the sample inbox. Production requires it to import mail.
ANTHROPIC_API_KEY=

# Bank connections through Plaid. Find the keys in the Plaid dashboard under Developers > Keys. Each
# Plaid environment has its own secret; PLAID_ENV (sandbox or production) says which one PLAID_SECRET
# is. The daily cron reads each connection's balances from /accounts/get, which is free, plus
# liabilities for connections with a card or loan and holdings for ones with an investment account.
# Plaid bills Liabilities and Investments per connection per month once they're first requested. The
# plan allows 10 production connections ever, so try things in sandbox. Leave both blank locally to
# sync only made-up connections. Production requires them once a real connection exists.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Travel times between itinerary stops. estimate (the default) works them out from distance and
# needs nothing. osrm asks an OSRM server for walking and driving routes, and sends it the trip's
# coordinates to do so.
ROUTING_PROVIDER=estimate
OSRM_URL=

# Document files. fake (the default) keeps uploads in the dev server's memory until it restarts.
# supabase stores them in the private `documents` bucket (migration 0006) and needs
# SUPABASE_SECRET_KEY. Production refuses fake.
STORAGE_PROVIDER=fake

# Error monitoring. Leave these blank and errors print to the server log, redacted, and nothing is
# sent anywhere. With SENTRY_DSN set, server errors and the daily cron's check-ins go to Sentry,
# without cookies, auth headers, emails, query strings or link tokens. Find the DSN in Sentry under
# Project Settings > Client Keys (DSN). NEXT_PUBLIC_SENTRY_DSN is usually the same value; it lets an
# error page report errors that happen only in the browser, and takes a redeploy to change.
# SENTRY_ENVIRONMENT defaults to VERCEL_ENV.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=

# Who gets an email when a cron job fails. Needs RESEND_API_KEY as well; without both, failures still
# show in job_runs and in Sentry, but nobody is emailed. Resend's test sender delivers only to your
# Resend account's address, so use that address until a domain is verified.
ALERT_EMAIL=
