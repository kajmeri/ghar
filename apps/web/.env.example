# Copy to .env.local. Supabase transaction pooler (port 6543); @casa/db disables prepared statements for it.
DATABASE_URL=postgresql://postgres.project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres

# Supabase Auth. With both set, an access token is verified by asking Supabase; with either
# missing, lib/providers/supabase-auth.ts falls back to its fake and DEV_USER_ID below.
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local development only. The household member you are signed in as, which is how the app
# runs before the magic-link flow exists. Ignored entirely once Supabase is configured, so
# setting it in a real deployment does nothing.
DEV_USER_ID=
