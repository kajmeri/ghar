{
  "expo": {
    "name": "Ghar",
    "slug": "ghar",
    "version": "0.0.0",
    "orientation": "portrait",
    "scheme": "ghar",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "app.ghar.mobile",
      "supportsTablet": false
    },
    "android": {
      "package": "app.ghar.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-background.png"
      }
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
